APP_NAME="Forms Mentorfy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=errorlog
LOG_LEVEL=debug

FILESYSTEM_DRIVER=local
LOCAL_FILESYSTEM_VISIBILITY=public

CACHE_DRIVER=redis

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=your@email.com
MAIL_FROM_NAME="Forms Mentorfy"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# 30 days. The auth cookie takes its Max-Age from this value, so it is what
# decides how long a session survives — including sessions opened through the
# Mentorfy SSO bridge, which should not ask the mentor to sign in again.
JWT_TTL=43200
# Kept above JWT_TTL so a token can never outlive its own refresh window.
JWT_REFRESH_TTL=44640
JWT_SECRET=
# Must match NUXT_API_SECRET in client/.env.docker. It is how AuthenticateJWT
# tells an SSR request apart from a replayed token.
FRONT_API_SECRET=secret
PUBLIC_UPLOADS_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOADS_RATE_LIMIT_PER_HOUR=300

OPEN_AI_API_KEY=

H_CAPTCHA_SITE_KEY=
H_CAPTCHA_SECRET_KEY=

RE_CAPTCHA_SITE_KEY=
RE_CAPTCHA_SECRET_KEY=

TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=

SHOW_OFFICIAL_TEMPLATES=true
