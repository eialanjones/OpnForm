{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.api",
    "watchPatterns": [
      "api/**",
      "docker/Dockerfile.api",
      "docker/php-fpm-entrypoint",
      "railway/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
