{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.api",
    "watchPatterns": ["api/**", "docker/Dockerfile.api", "docker/php-fpm-entrypoint"]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/opnform-entrypoint php artisan queue:work --tries=1 --timeout=120",
    "restartPolicyType": "ALWAYS"
  }
}
