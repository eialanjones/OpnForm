{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.api",
    "watchPatterns": ["api/**", "docker/Dockerfile.api", "docker/php-fpm-entrypoint"]
  },
  "deploy": {
    "startCommand": "php artisan schedule:work",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
