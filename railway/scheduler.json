{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.api",
    "watchPatterns": [
      "api/**",
      "docker/Dockerfile.api",
      "docker/php-fpm-entrypoint",
      "railway/**"
    ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/opnform-entrypoint php artisan schedule:work",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
