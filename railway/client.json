{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.client",
    "watchPatterns": [
      "client/**",
      "docker/Dockerfile.client",
      "railway/**"
    ]
  },
  "deploy": {
    "startCommand": "node ./server/index.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
